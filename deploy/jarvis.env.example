# Plantilla de /etc/jarvis-sapo/jarvis.env (EnvironmentFile del servicio
# jarvis-sapo.service). SOLO valores no secretos; es una plantilla, no se usa
# directamente en producción.
#
# El fichero real (/etc/jarvis-sapo/jarvis.env) NUNCA se versiona. Créalo a
# mano en el CT con permisos 0640 root:jarvis:
#   install -o root -g jarvis -m 0640 deploy/jarvis.env.example /etc/jarvis-sapo/jarvis.env
#   $EDITOR /etc/jarvis-sapo/jarvis.env
# y añade a mano las claves (ANTHROPIC_*, Google, Fish Audio, etc.) que
# correspondan — ninguna de ellas va en este fichero de ejemplo.

# Dónde escribe jarvis-sapo su base SQLite, memoria y token interno
# (data_paths.py: data_dir()). Debe apuntar al ReadWritePaths del servicio.
JARVIS_DATA_DIR=/var/lib/jarvis-sapo

# Orígenes extra que el boundary web acepta (web_auth.py), separados por
# coma: necesarios porque la página se sirve desde Caddy con el nombre y la
# IP de tu red, no desde localhost/127.0.0.1 donde escucha el backend.
# Sustituye los marcadores por tus valores reales en el fichero del contenedor
# (fuera del repositorio): JARVIS_HOST y JARVIS_LAN_IP.
JARVIS_ALLOWED_ORIGINS=https://<JARVIS_HOST>,https://<JARVIS_LAN_IP>
