# La voz de JARVIS: una clave de Fish Audio, O déjala sin definir y se usa la
# voz local de Piper (port a Linux: pip install -r requirements-linux.txt, ver README).
FISH_API_KEY=your-fish-audio-api-key-here

# Opcional: motor y voz de salida (se eligen también en Ajustes; ver docs/voz.md).
# auto = Fish si hay clave y funciona, si no Piper. Edge es una voz en la NUBE
# (el texto sale hacia Microsoft): solo se usa si lo pones aquí a propósito.
# JARVIS_TTS_PROVIDER=auto      # auto | piper | kokoro | edge | fish | none
# JARVIS_TTS_VOICE=es_ES-davefx-medium
# Velocidad de Piper: 1.0 = la de la voz; más de 1 = más lenta (0.7-1.6)
# PIPER_LENGTH_SCALE=1.1

# Idioma en el que JARVIS habla y escucha: en (por defecto) o es.
# JARVIS_LANGUAGE=es

# El cerebro de JARVIS es un proceso de Claude Code que corre con TU suscripción
# de Claude. Instala Claude Code (2.1.224+) e inicia sesión con `claude`: no hace
# falta ninguna clave de API de Anthropic para nada, y cualquier variable
# ANTHROPIC_* definida aquí se oculta a propósito al cerebro para que solo pueda
# usar tu inicio de sesión.

# Opcional: modelo que usa el cerebro (por defecto sonnet; siempre se pasa explícito)
# JARVIS_BRAIN_MODEL=sonnet

# Opcional: modelo de voz de Fish Audio (por defecto, la voz JARVIS del UCM)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Opcional: tu nombre (JARVIS se dirigirá a ti por él)
# USER_NAME=Tony

# Opcional: si se omiten las peticiones de permiso del CLI de Claude en las
# llamadas a subprocesos. Por defecto es "true" porque JARVIS se maneja por voz
# y no puede responder a peticiones de permiso interactivas (colgarían el
# subproceso en silencio). Pon "false" para exigir peticiones de permiso
# explícitas: solo sirve si ejecutas JARVIS de forma interactiva en un terminal
# que puedas ver y atender.
# JARVIS_SKIP_PERMISSIONS=true

# Opcional: fijar la ubicación del tiempo en lugar de la autodetectada.
# Por defecto, JARVIS usa la ubicación de tu IP pública (vía ipwho.is) y da la
# temperatura en Fahrenheit. Define esto para fijar un lugar concreto:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # o "celsius"

# Opcional: reconocimiento de voz en esta máquina en lugar del de Chrome (nube
# de Google). Necesita faster-whisper; ver requirements-linux.txt y docs/stt-local.md.
# JARVIS_STT=browser            # browser (por defecto) | local
# JARVIS_STT=auto               # auto: Chrome usa el suyo, Firefox el local
# JARVIS_WAKE_WORD=off          # on = tras "Hey Jarvis" (openWakeWord, inglés, solo con local)
#                               # whisper = solo atiende frases que EMPIEZAN por "Jarvis" (sin modelo extra)
# JARVIS_WAKE_WINDOW_SEC=20     # con whisper: segundos para seguir hablando sin repetir "Jarvis"
# JARVIS_STT_MODEL=base         # tamaño de Whisper; en castellano se usa el multilingüe
# JARVIS_BARGE_IN=off           # on = hablar encima de JARVIS lo calla (voz local)
# JARVIS_BARGE_IN_RMS=1200      # nivel mínimo de tu voz (0-32768); súbelo si se corta con su propio eco
# JARVIS_BARGE_IN_MS=400        # cuánto tiempo seguido tienes que hablar
